# Supabase — copy to .env.local and fill in your values (embedded in client bundle via NEXT_PUBLIC_*)
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-or-publishable-key>

# Subdomain apps (optional overrides; defaults match meetpawan.com DNS)
NEXT_PUBLIC_BLOG_HOSTNAME=blog.meetpawan.com
NEXT_PUBLIC_FRONTEND_HOSTNAME=frontend.meetpawan.com

# Optional: canonical site URL for metadata (defaults to https://meetpawan.com)
# NEXT_PUBLIC_SITE_URL=https://meetpawan.com
#
# Optional: blog-only canonical origin for sitemap/OG (e.g. https://blog.meetpawan.com)
# NEXT_PUBLIC_BLOG_CANONICAL_URL=https://blog.meetpawan.com
#
# Local dev — modern browsers resolve *.localhost to 127.0.0.1:
#   http://localhost:5199
#   http://blog.localhost:5199
#   http://frontend.localhost:5199
# Optional: map real hostnames via hosts → same URLs with .meetpawan.com

# Do NOT put your Resend API key here with NEXT_PUBLIC_ — it would ship to the browser.
# Contact-form email uses a Supabase Edge Function; set RESEND_API_KEY and
# NOTIFY_TO_EMAIL with: npx supabase secrets set ...

# Adding another subdomain later: add `app/<name>/` routes, middleware + hostRouting,
# NEXT_PUBLIC_<NAME>_HOSTNAME in this file, and an entry in `src/config/hostApps.ts`
# with a unique devLocalHost like labs.localhost.
# Vercel: add the hostname under the same project; DNS CNAME as instructed.
